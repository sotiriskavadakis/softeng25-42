def getsessions(args):
    """Λήψη συνεδριών φόρτισης για συγκεκριμένο σημείο"""
    url = f"{BASE_URL}/sessions/{args.id}/{args.datefrom}/{args.dateto}"
    
    params = {}
    if args.format:
        params['format'] = args.format
    
    token = get_token(args)
    if not token:
        print("Σφάλμα: Δεν είστε συνδεδεμένοι. Χρησιμοποιήστε 'se2542 login' ή την παράμετρο --token")
        return
    
    headers = {'Authorization': f'Bearer {token}'}
    
    try:
        response = requests.get(url, params=params, headers=headers)
        
        if response.status_code == 200:
            # Έλεγχος αν είναι CSV
            if args.format == 'csv':
                print(response.text)
            else:
                sessions = response.json()
                print(f"=== Sessions για Point {args.id} ===")
                print(f"Περίοδος: {args.datefrom} - {args.dateto}")
                print(f"Βρέθηκαν {len(sessions)} συνεδρίες\n")
                
                print(f"{'Έναρξη':<18} {'Λήξη':<18} {'SOC':<10} {'kWh':<8} {'Τιμή/kWh':<10} {'Ποσό':<8}")
                print("-" * 75)
                for s in sessions:
                    soc = f"{s.get('startsoc', 'N/A')}%->{s.get('endsoc', 'N/A')}%"
