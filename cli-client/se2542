#!/usr/bin/env python3
import argparse
import requests
import os

BASE_URL = "http://localhost:9876/api"
TOKEN_FILE = os.path.expanduser("~/.se2542_token")

def get_saved_token():
    """Διαβάζει το αποθηκευμένο token από το αρχείο"""
    if os.path.exists(TOKEN_FILE):
        with open(TOKEN_FILE, 'r') as f:
            return f.read().strip()
    return None

def save_token(token):
    """Αποθηκεύει το token στο αρχείο"""
    with open(TOKEN_FILE, 'w') as f:
        f.write(token)
    os.chmod(TOKEN_FILE, 0o600)  # Μόνο ο χρήστης μπορεί να διαβάσει

def delete_token():
    """Διαγράφει το αποθηκευμένο token"""
    if os.path.exists(TOKEN_FILE):
        os.remove(TOKEN_FILE)

def get_token(args):
    """Επιστρέφει token από args ή από αρχείο"""
    if hasattr(args, 'token') and args.token:
        return args.token
    return get_saved_token()

def login(args):
    """Σύνδεση χρήστη και αποθήκευση token"""
    url = f"{BASE_URL}/auth/login"
    
    data = {
        'email': args.email,
        'password': args.password
    }
    
    try:
        response = requests.post(url, json=data)
        
        if response.status_code == 200:
            result = response.json()
            token = result.get('token')
            if token:
                save_token(token)
                print("Επιτυχής σύνδεση! Το token αποθηκεύτηκε.")
            else:
                print("Σφάλμα: Δεν ελήφθη token")
        elif response.status_code == 401:
            print("Σφάλμα: Λάθος email ή κωδικός")
        else:
            print(f"Σφάλμα: {response.status_code} - {response.text}")
    except requests.exceptions.ConnectionError:
        print("Σφάλμα: Δεν είναι δυνατή η σύνδεση με τον server")
    except Exception as e:
        print(f"Σφάλμα: {e}")

def logout(args):
    """Αποσύνδεση - διαγραφή του αποθηκευμένου token"""
    delete_token()
    print("Αποσυνδεθήκατε επιτυχώς.")

def get_points(args):
    """Λήψη όλων των σημείων φόρτισης"""
    url = f"{BASE_URL}/points"
    params = {}
    
    if args.status:
        params['status'] = args.status
    if args.format:
        params['format'] = args.format
    if args.min_lat:
        params['min_lat'] = args.min_lat
    if args.max_lat:
        params['max_lat'] = args.max_lat
    if args.min_lon:
        params['min_lon'] = args.min_lon
    if args.max_lon:
        params['max_lon'] = args.max_lon
    
    try:
        response = requests.get(url, params=params)
        
        if response.status_code == 200:
            points = response.json()
            if not points:
                print("Δεν βρέθηκαν σημεία φόρτισης.")
                return
            
            print(f"{'ID':<10} {'Provider':<15} {'Status':<12} {'Cap (kW)':<10} {'Lat':<12} {'Lon':<12}")
            print("-" * 75)
            for point in points:
                print(f"{point.get('pointid', 'N/A'):<10} "
                      f"{point.get('providerΝame', 'N/A'):<15} "
                      f"{point.get('status', 'N/A'):<12} "
                      f"{point.get('cap', 'N/A'):<10} "
                      f"{point.get('lat', 'N/A'):<12} "
                      f"{point.get('lon', 'N/A'):<12}")
        elif response.status_code == 204:
            print("Δεν βρέθηκαν σημεία φόρτισης με τα συγκεκριμένα κριτήρια.")
        else:
            print(f"Σφάλμα: {response.status_code} - {response.text}")
    except requests.exceptions.ConnectionError:
        print("Σφάλμα: Δεν είναι δυνατή η σύνδεση με τον server. Βεβαιωθείτε ότι τρέχει στο localhost:9876")
    except Exception as e:
        print(f"Σφάλμα: {e}")

