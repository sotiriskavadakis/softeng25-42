        elif response.status_code == 204:
            print(f"Δεν βρέθηκαν συνεδρίες για το σημείο {args.id} στην περίοδο {args.datefrom} - {args.dateto}")
        elif response.status_code == 401:
            print("Σφάλμα: Μη εξουσιοδοτημένη πρόσβαση. Παρακαλώ δώστε έγκυρο token με --token")
        elif response.status_code == 404:
            print(f"Σφάλμα: Το σημείο με ID '{args.id}' δεν βρέθηκε.")
        elif response.status_code == 400:
            print(f"Σφάλμα: Μη έγκυρη μορφή ημερομηνίας. Χρησιμοποιήστε YYYYMMDD")
        else:
