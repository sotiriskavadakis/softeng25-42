def addpoints(args):
    """Εισαγωγή νέων σημείων φόρτισης από CSV αρχείο"""
    url = f"{BASE_URL}/admin/addpoints"
    
    # Έλεγχος αν το αρχείο υπάρχει
    if not os.path.exists(args.source):
        print(f"Σφάλμα: Το αρχείο '{args.source}' δεν βρέθηκε.")
        return
    
    token = get_token(args)
    if not token:
        print("Σφάλμα: Δεν είστε συνδεδεμένοι. Χρησιμοποιήστε 'se2542 login' ή την παράμετρο --token")
        return
    
    headers = {'Authorization': f'Bearer {token}'}
    
    try:
        with open(args.source, 'rb') as f:
            files = {'file': (os.path.basename(args.source), f, 'text/csv')}
