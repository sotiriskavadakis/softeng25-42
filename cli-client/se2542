def main():
    parser = argparse.ArgumentParser(
        prog='se2542',
        description="CLI για EV Charging API - Ομάδα softeng25-42"
    )
    subparsers = parser.add_subparsers(dest="command", help="Διαθέσιμες εντολές")
    
    # Subparser για login
    login_parser = subparsers.add_parser("login", help="Σύνδεση χρήστη")
    login_parser.add_argument("--email", type=str, required=True, help="Email χρήστη")
    login_parser.add_argument("--password", type=str, required=True, help="Κωδικός πρόσβασης")
    login_parser.set_defaults(func=login)
    
    # Subparser για logout
    logout_parser = subparsers.add_parser("logout", help="Αποσύνδεση χρήστη")
    logout_parser.set_defaults(func=logout)
    
    # Subparser για getpoints
    points_parser = subparsers.add_parser("getpoints", help="Λήψη σημείων φόρτισης")
    points_parser.add_argument("--status", type=str, 
                               choices=["available", "occupied", "reserved", "faulted", "offline"],
                               help="Φιλτράρισμα με βάση την κατάσταση")
    points_parser.add_argument("--format", type=str, choices=["json", "csv"], default="csv",
                               help="Μορφή εξόδου (json ή csv, προεπιλογή: csv)")
    points_parser.add_argument("--min-lat", dest="min_lat", type=float, help="Ελάχιστο γεωγραφικό πλάτος")
    points_parser.add_argument("--max-lat", dest="max_lat", type=float, help="Μέγιστο γεωγραφικό πλάτος")
    points_parser.add_argument("--min-lon", dest="min_lon", type=float, help="Ελάχιστο γεωγραφικό μήκος")
    points_parser.add_argument("--max-lon", dest="max_lon", type=float, help="Μέγιστο γεωγραφικό μήκος")
    points_parser.set_defaults(func=get_points)
    
    # Subparser για getpoint (by ID)
    point_parser = subparsers.add_parser("getpoint", help="Λήψη λεπτομερειών σημείου με ID")
    point_parser.add_argument("--id", type=str, required=True, help="ID του σημείου φόρτισης")
