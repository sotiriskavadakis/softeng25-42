@startuml
skinparam componentStyle uml2
skinparam linetype ortho
left to right direction

'--- Styling ---
skinparam backgroundColor white
skinparam component {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  ArrowColor #455A64
  FontName Arial
  FontSize 12
}
skinparam component<<subsystem>> {
  BackgroundColor #F5F5F5
  BorderColor #424242
  BorderStyle dashed
}
skinparam interface {
  BackgroundColor #1565C0
  BorderColor #1565C0
}
skinparam port {
  BackgroundColor #FFCA28
  BorderColor #FFA000
}

' Increase spacing for orthogonal lines
skinparam nodesep 60
skinparam ranksep 60

'--- External Actors ---
interface "User/Admin" as ExtUser
interface "External\nPayment API" as ExtPayment
interface "Charger\nHardware (OCPP)" as ExtHW
interface "3rd Party\nIdentity Provider" as ExtSSO

'--- The Main Subsystem Boundary ---
component "EV Charging System" <<subsystem>> {

    '--- Ports ---
    port "UI Port" as P_UI
    port "Bank Port" as P_Bank
    port "HW Port" as P_HW
    port "Auth Port" as P_Auth

    '--- Internal Grouping ---
    package "Presentation Layer" {
        component "Dashboard UI" as Dash
    }

    package "Core Business Logic" {
        component "Auth Service" as Auth
        component "Search Service" as Search
        component "Reservation\nManager" as Res
        component "Session\nManager" as Session
        component "Billing Service" as Billing
    }

    package "Data Layer" {
        component "Database\nAccess" as DB
    }

    '--- Internal Interfaces (Wiring) ---
    
    ' 1. Auth (Now connects to SSO Port)
    interface "IAuth"
    Auth -left- IAuth
    Dash --( IAuth
    Auth --(0- P_Auth : verifies token

    ' 2. Search
    interface "ISearch"
    Search -left- ISearch
    Dash --( ISearch

    ' 3. Reservation
    interface "IBooking"
    Res -left- IBooking
    Dash --( IBooking

    ' 4. Billing
    interface "IBilling"
    Billing -up- IBilling
    Res --( IBilling
    Session --( IBilling

    ' 5. Database (Shared)
    interface "IData"
    DB -left- IData
    Auth --( IData
    Search --( IData
    Res --( IData
    Session --( IData

    '--- Port Connections ---
    P_UI -right- Dash
    
    ' Connect bottom components to bottom ports
    Session --(0- P_HW
    Billing --(0- P_Bank

    '--- Layout Helpers ---
    Auth -[hidden]down- Search
    Search -[hidden]down- Res
    Res -[hidden]down- Session
    Session -[hidden]down- Billing
}

'--- External Connections ---
ExtUser -- P_UI

' Bottom External Systems
P_Auth -- ExtSSO
P_Bank -- ExtPayment
P_HW -- ExtHW

' Organize bottom row
ExtSSO -[hidden]left- ExtPayment
ExtPayment -[hidden]left- ExtHW

@enduml