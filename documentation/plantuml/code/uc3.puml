@startuml
title Activity Diagram – Admin View Statistics (Cleanest Version)

start

:Admin logs in;
:Admin opens "Statistics Dashboard";

' --- INITIAL LOAD ---
:System loads initial statistics using default range:
 - total revenue
 - total kWh
 - total sessions
 - avg session duration
 - peak hours
 - most used areas;

:System displays summary metrics and charts;

' --- FILTER FLOW ---
if (Admin changes filters?) then (Yes)
    :Admin selects date range / station / area;
    :System reloads statistics;
else (No)
endif

' --- CATEGORY SELECTION ---
:Admin selects statistics category;

' ===== SYSTEM-WIDE =====
if (Category == System-wide) then (Overall Stats)
    :System shows system-wide metrics (based on selected range):
      - sessions
      - kWh
      - revenue
      - peak hours
      - utilization overview;
endif

' ===== PER STATION =====
if (Category == Per Station) then (Station Stats)
    :System shows station analytics (based on selected range):
      - sessions
      - kWh
      - revenue
      - utilization
      - peak hours;
endif

' ===== PER CHARGER =====
if (Category == Per Charger) then (Charger Stats)
    :System shows charger analytics (based on selected range):
      - sessions
      - avg session duration
      - kWh
      - revenue
      - peak hours
      - fault occurrences;
endif

' ===== PER AREA =====
if (Category == Per Area) then (Area Stats)
    :System shows area analytics (based on selected range):
      - sessions
      - kWh
      - revenue
      - most used areas
      - peak hours;
endif

' --- EXPORT FLOW ---
if (Admin exports data?) then (Yes)
    :Admin selects CSV/PDF;
    :System generates export file;
    :Admin downloads file;
endif

stop
@enduml